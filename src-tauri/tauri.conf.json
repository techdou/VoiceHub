{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoiceHub",
  "version": "0.2.0",
  "identifier": "app.soundbridge.windows",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "声枢 VoiceHub",
        "label": "main",
        "width": 1180,
        "height": 800,
        "decorations": false,
        "dragDropEnabled": false,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: data:; worker-src 'self' blob: data:; connect-src 'self' ipc: http: https: ws: wss:; media-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../vendor/sayit/native/resources/*": "resources/",
      "transcribe-libs/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
